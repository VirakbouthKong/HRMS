# Secrets only. Every other setting lives in backend/config-repo/cron-service.yml (Config Server).
DB_URL=jdbc:postgresql://<neon-host>/<database>?sslmode=require&channelBinding=require
DB_USERNAME=<neon-username>
DB_PASSWORD=<neon-password>

# Must match INTERNAL_API_KEY in backend/.env (Docker Compose also sets it from there)
INTERNAL_API_KEY=<generate-a-long-random-secret>
