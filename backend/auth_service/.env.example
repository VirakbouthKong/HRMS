# Secrets only. Every other setting lives in backend/config-repo/auth-service.yml (Config Server).
# Docker reads this file; IntelliJ runs read it too (spring.config.import).
DB_URL=jdbc:postgresql://<neon-host>/<database>?sslmode=require&channelBinding=require
DB_USERNAME=<neon-username>
DB_PASSWORD=<neon-password>

# Only for IntelliJ runs (Docker Compose sets these from backend/.env):
# INTERNAL_API_KEY=<same value as in backend/.env>
# BOOTSTRAP_ADMIN_USERNAME=sysadmin
# BOOTSTRAP_ADMIN_PASSWORD=<choose-a-password>
# BOOTSTRAP_ADMIN_EMAIL=sysadmin@hrms.local
