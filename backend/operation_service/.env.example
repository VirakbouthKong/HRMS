# Copy these values into your IDE run configuration or PowerShell environment
# Do not commit a real .env file or paste Neon passwords into Git

# Shared database: Neon PostgreSQL
SPRING_DATASOURCE_URL=jdbc:postgresql://<neon-host>/<database>?sslmode=require
SPRING_DATASOURCE_USERNAME=<neon-username>
SPRING_DATASOURCE_PASSWORD=<neon-password>
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_FLYWAY_ENABLED=true
SPRING_FLYWAY_BASELINE_ON_MIGRATE=true
SPRING_FLYWAY_BASELINE_VERSION=1

# Operation service
SPRING_APPLICATION_NAME=operation-service
SERVER_PORT=8081
APP_TIME_ZONE=Asia/Phnom_Penh
APP_WORKDAY_START=08:00
APP_WORKDAY_END=17:00
APP_LATE_GRACE_MINUTES=15

# Integration contracts supplied by teammate services
AUTH_JWK_SET_URI=https://<auth-host>/.well-known/jwks.json
INTERNAL_API_KEY=<generate-a-long-random-secret>

# CRON service (use when cron-service is created)
CRON_SERVER_PORT=8082
OPERATION_SERVICE_BASE_URL=http://localhost:8081
REPORTING_SERVICE_BASE_URL=http://localhost:8083
CRON_ABSENCE_SCHEDULE=0 5 0 * * TUE-SAT
