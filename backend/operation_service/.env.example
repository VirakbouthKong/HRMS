# Secrets only. Every other setting lives in backend/config-repo/operation-service.yml (Config Server).
# Do not commit a real .env file or paste Neon passwords into Git.
SPRING_DATASOURCE_URL=jdbc:postgresql://<neon-host>/<database>?sslmode=require
SPRING_DATASOURCE_USERNAME=<neon-username>
SPRING_DATASOURCE_PASSWORD=<neon-password>

# Must match INTERNAL_API_KEY in backend/.env (Docker Compose also sets it from there)
INTERNAL_API_KEY=<generate-a-long-random-secret>
