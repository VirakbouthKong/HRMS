# Secrets shared by docker-compose.yml. Copy to backend/.env (never commit .env).
# All other settings live in backend/config-repo (Spring Cloud Config Server).

# Shared secret between gateway -> auth and cron -> operation. Use a long random string.
INTERNAL_API_KEY=<generate-a-long-random-secret>

# First ADMIN account, created by the Auth service on startup if the username does not exist.
BOOTSTRAP_ADMIN_USERNAME=sysadmin
BOOTSTRAP_ADMIN_PASSWORD=<choose-a-password>
BOOTSTRAP_ADMIN_EMAIL=sysadmin@hrms.local

# Email. Leave these commented to use Mailpit (inbox at http://localhost:8025).
# For real emails with Gmail, uncomment and fill in (needs a Gmail App Password).
# These override the Mailpit defaults in config-repo/auth-service.yml.
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=you@gmail.com
# MAIL_PASSWORD=<16-character-app-password>
# MAIL_SMTP_AUTH=true
# MAIL_SMTP_STARTTLS=true
# MAIL_FROM=HRMS <you@gmail.com>
